{
  "rule_version": "purchasing-rules-1.0",
  "reconciliation_version": "three-way-1.0",
  "contract_version": "purchasing-1.0",
  "numeric_policy": {
    "arithmetic": "decimal",
    "rounding": "ROUND_HALF_UP",
    "tax_calculation": "round_each_line_net_times_percentage_to_2_then_sum",
    "maximum_integer_digits": 12,
    "quantity_decimal_places": 6,
    "unit_price_decimal_places": 4,
    "tax_rate_decimal_places": 4,
    "money_decimal_places": 2,
    "money_absolute_tolerance": "0.01",
    "quantity_absolute_tolerance": "0",
    "unit_price_absolute_tolerance": "0.0001",
    "tax_rate_percentage_absolute_tolerance": "0.0001",
    "tolerance_accumulation": "forbidden_document_and_case_aggregate_amounts_are_also_checked_at_0.01",
    "material_partial_invoice_tax_rounding": "review_if_fully_invoiced_tax_differs_from_order_tax_by_more_than_0.01",
    "scientific_notation_allowed": false,
    "nonfinite_values_allowed": false,
    "silent_correction_allowed": false
  },
  "classification": {
    "minimum_score": 0.8,
    "threshold_status": "provisional_review_gate_not_a_calibrated_probability_claim",
    "score_alone_is_evidence": false
  },
  "document_decisions": {
    "eligible": "All required values have provenance and all deterministic checks pass; human approval is still required.",
    "review": "Missing/abstained data, unknown type/contract/currency, low classification score, absent provenance or unsupported fields.",
    "rejected": "Malformed values, invalid signs, unjustified correction or an arithmetic/identifier contradiction."
  },
  "case_policy": {
    "purchase_orders_per_case": 1,
    "delivery_notes_per_case": "one_or_more",
    "invoices_per_case": "one_or_more",
    "selection": "latest_active_version_of_each_logical_document_selected_transactionally_by_service",
    "duplicate_identity": ["kind", "supplier_id", "document_id"],
    "duplicate_content": "sha256",
    "join_keys": ["purchase_order_id", "supplier_id", "currency", "sku"],
    "quantity_invariant": "0 <= cumulative_invoiced <= cumulative_delivered <= ordered_per_sku",
    "repeated_sku_within_document": "review_without_aggregation_because_line_ids_are_not_modelled",
    "missing_piece": "missing_not_zero_quantity",
    "partial_delivery_and_invoicing": "allowed_when_all_quantity_and_price_invariants_hold",
    "status_precedence": ["contradictory", "review", "missing", "partial", "matched"]
  },
  "unsupported_business_cases": [
    "credit_notes_and_returns",
    "negative_or_zero_quantities",
    "discounts_allowances_freight_and_withholding",
    "multiple_order_case",
    "multiple_order_lines_with_same_sku",
    "foreign_exchange_conversion",
    "cash_rounding_or_non_two_decimal_currency",
    "tax_exemption_evidence_and_jurisdiction_specific_tax_advice"
  ]
}
